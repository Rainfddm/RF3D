# suFab 3D 打印系统 API 密钥配置（模板）
# 复制此文件为 .env 并填入真实密钥。.env 已被 .gitignore 排除，不会进版本库。

# ── 提供方选择 ────────────────────────────────────────────────
# AI_PROVIDER 可填：deepseek / kimi
# 不填时自动挑选第一个已配置 key 的提供方（deepseek → kimi）
AI_PROVIDER=deepseek
# 不填则用该提供方的默认模型（deepseek-chat / moonshot-v1-8k）
AI_MODEL=deepseek-chat

# ── DeepSeek ─────────────────────────────────────────────────
# 申请地址：https://platform.deepseek.com/api_keys
# 端点：https://api.deepseek.com/v1（OpenAI 兼容协议）
DEEPSEEK_API_KEY=your-key-here

# ── Moonshot (Kimi) ──────────────────────────────────────────
# 申请地址：https://platform.moonshot.cn/console/api-keys
# 端点：https://api.moonshot.cn/v1
MOONSHOT_API_KEY=your-key-here

# ── 通用 ─────────────────────────────────────────────────────
# 兜底密钥：当对应提供方的专用变量为空时使用（兼容旧配置）
OPENAI_API_KEY=your-key-here

# ── 服务端 ───────────────────────────────────────────────────
# 会话签名密钥。生产环境**必须**设置：
# 不设置时 create_app 会每进程随机生成，多 worker 部署会导致登录随机失效。
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-random-64-hex-string

# 数据库连接串。默认情况**不要设置**：Config 会使用
#   <包根>/instance/rf3d_users.db   （绝对路径，与工作目录无关）
# 该目录由 create_app() 自动创建。需要切库时才取消注释：
# DATABASE_URL=postgresql+psycopg2://user:pass@127.0.0.1:5432/rf3d
# DATABASE_URL=sqlite:///C:/data/rf3d.db
#
# 注意：如果写成相对路径（sqlite:///instance/x.db），SQLite 会按**当前工作目录**
# 解析，从别的目录启动就会连到另一份库。发布场景建议留空用默认值。

# 允许跨域的前端来源，逗号分隔
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
